# Copy to .env and fill in what you need. Every line is optional.
# .env is ignored by git. Never commit real values.

# Signs session and permission tokens. At least 32 characters.
# Left empty, a random key is generated once and kept next to the database.
AUTH_SECRET=

# First administrator. Applied to the supervising person at start-up.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Password-free demo sign-in for the seeded people. Set to 0 to turn it off.
DEMO_LOGIN=1

# Agents follow a fixed script unless AGENT_RUNTIME=model, in which case each
# agent step is a call to the model below using ANTHROPIC_API_KEY.
AGENT_RUNTIME=
AGENT_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Where the SQLite file lives. Defaults to ./data/office.db.
OFFICE_DB_PATH=

# Host port published by docker compose.
OFFICE_PORT=8080
