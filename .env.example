# Copy to .env and fill in what you need. Every line is optional.
# .env is ignored by git. Never commit real values.

# Signs session and permission tokens, and protects stored API keys.
# At least 32 characters. Left empty, a random key is generated once and kept
# next to the database. If this value changes, everyone is signed out and
# stored API keys have to be entered again.
AUTH_SECRET=

# An account created at start-up. It gets an empty office of its own, separate
# from the demo office.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# The demo office and password-free entry to it. Set to 0 to turn both off.
DEMO_LOGIN=1

# Whether anyone can create an account on the sign-in page. Set to 0 to leave
# invites and the account above as the only ways in.
SIGNUP=1

# While sign-up is on, a connected system or an AI provider may not sit at an
# address inside this server's own network. Set to 1 to allow it, for a model
# served on this machine for example. Not needed when SIGNUP=0.
# ALLOW_PRIVATE_ADDRESSES=1

# Where the SQLite file lives. Defaults to ./data/office.db.
OFFICE_DB_PATH=

# Host port published by docker compose.
OFFICE_PORT=8080

# The key the office and the sample services
# share inside the compose stack. The services are not published outside it.
DEMO_SYSTEMS_KEY=

# Outside docker compose, run "npm run services" and set these so that the
# demo office connects to the sample services on this machine.
# DEMO_STOREFRONT_URL=http://127.0.0.1:8081
# DEMO_CARRIER_URL=http://127.0.0.1:8082
# DEMO_LEDGER_URL=http://127.0.0.1:8083
# DEMO_SUPPLIER_URL=http://127.0.0.1:8084
# DEMO_SERVICE_DESK_URL=http://127.0.0.1:8085

# AI providers are not configured here. Each office adds its own providers,
# models and API keys under Settings, AI providers.
