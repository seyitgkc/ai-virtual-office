# Copy to .env and fill in what you need. Every line is optional.
# .env is ignored by git. Never commit real values.

# Signs session and permission tokens, and protects stored API keys.
# At least 32 characters. Left empty, a random key is generated once and kept
# next to the database. If this value changes, everyone is signed out and
# stored API keys have to be entered again.
AUTH_SECRET=

# An account created at start-up. It gets an empty office of its own, separate
# from the demo office.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# The demo office and password-free entry to it. Set to 0 to turn both off.
DEMO_LOGIN=1

# Where the SQLite file lives. Defaults to ./data/office.db.
OFFICE_DB_PATH=

# Host port published by docker compose.
OFFICE_PORT=8080

# AI provider settings are not configured here. Each office sets its own model
# and API key in Settings, AI provider.
